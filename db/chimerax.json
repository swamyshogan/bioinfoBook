{
  "tool": "chimerax",
  "description": "Molecular visualization — open structures, style, colour, select, measure, superimpose, maps, figures and movies",
  "homepage": "https://www.cgl.ucsf.edu/chimerax/",
  "cheats": [
    {"title": "Fetch a PDB entry", "cmd": "open {{pdb_id:1abc}}"},
    {"title": "Open a local file", "cmd": "open {{file}}", "notes": "Works for .pdb .cif .mrc .map .cxs sessions and more"},
    {"title": "Fetch an AlphaFold model", "cmd": "alphafold fetch {{uniprot_id}}"},
    {"title": "Fetch an EM map from EMDB", "cmd": "open {{emdb_id}} from emdb"},
    {"title": "Run a command script", "cmd": "open {{script:commands.cxc}}", "notes": "A .cxc file is just ChimeraX commands, one per line. .py files run as Python."},
    {"title": "Change working folder", "cmd": "cd {{folder}}"},
    {"title": "Close everything", "cmd": "close"},
    {"title": "Close one model", "cmd": "close #{{model:1}}"},
    {"title": "Cartoon only (hide atoms)", "cmd": "hide atoms; show cartoons"},
    {"title": "Show ligands as sticks", "cmd": "show ligand; style ligand stick"},
    {"title": "Show residues around the ligand", "cmd": "show ligand :<{{distance:5}}", "notes": "Whole residues with any atom within that many Å of the ligand"},
    {"title": "Hide water and ions", "cmd": "hide solvent; hide ions"},
    {"title": "Delete water", "cmd": "delete solvent"},
    {"title": "Change atom style", "cmd": "style {{spec:sel}} {{style:stick}}", "notes": "Styles: stick, ball, sphere"},
    {"title": "Tube helices", "cmd": "cartoon style protein modeHelix tube"},
    {"title": "White background", "cmd": "set bgColor white"},
    {"title": "Publication look (soft light + outlines)", "cmd": "lighting soft; graphics silhouettes true"},
    {"title": "Full lighting with shadows", "cmd": "lighting full"},
    {"title": "Set window size", "cmd": "windowsize {{width:1600}} {{height:1200}}"},
    {"title": "Color by chain", "cmd": "color bychain"},
    {"title": "Color heteroatoms (N blue, O red…)", "cmd": "color byhetero"},
    {"title": "Rainbow N → C terminus", "cmd": "rainbow"},
    {"title": "Color by AlphaFold confidence (pLDDT)", "cmd": "color bfactor palette alphafold"},
    {"title": "Color something", "cmd": "color {{spec:sel}} {{color:hot pink}}"},
    {"title": "Electrostatic surface", "cmd": "surface; coulombic"},
    {"title": "Hydrophobicity surface", "cmd": "surface; mlp"},
    {"title": "Transparent surface", "cmd": "transparency {{spec:#1}} {{percent:50}} target s"},
    {"title": "Select a chain", "cmd": "select /{{chain:A}}"},
    {"title": "Select a residue range", "cmd": "select /{{chain:A}}:{{start}}-{{end}}"},
    {"title": "Select residues near the ligand", "cmd": "select ligand :<{{distance:5}}"},
    {"title": "Invert the selection", "cmd": "select ~sel"},
    {"title": "Clear the selection", "cmd": "select clear"},
    {"title": "Name a selection to reuse it", "cmd": "name {{name}} sel", "notes": "Then use the name anywhere a spec goes, e.g. color pocket gold"},
    {"title": "Mouse: pick atoms", "cmd": "Ctrl+click   ·   Ctrl+Shift+click to add   ·   Up arrow to grow (residue → chain → model)"},
    {"title": "Atom spec cheat sheet", "cmd": "#1/A:100@CA", "notes": "#model  /chain  :residue  @atom  —  e.g. #1/A:50-60, :HIS, @CA, & (and), | (or), ~ (not)"},
    {"title": "Hydrogen bonds to the ligand", "cmd": "hbonds ligand reveal true"},
    {"title": "Contacts with the ligand", "cmd": "contacts ligand reveal true"},
    {"title": "Find clashes", "cmd": "clashes {{spec:#1}}"},
    {"title": "Measure a distance", "cmd": "distance {{atom1:/A:45@OG}} {{atom2:/B:102@NZ}}", "notes": "Remove with  ~distance"},
    {"title": "Solvent accessible surface area", "cmd": "measure sasa #{{model:1}}"},
    {"title": "Buried area between two chains", "cmd": "measure buriedarea /{{chain1:A}} withAtoms2 /{{chain2:B}}"},
    {"title": "Chain interfaces diagram", "cmd": "interfaces #{{model:1}}"},
    {"title": "Add hydrogens", "cmd": "addh"},
    {"title": "Mutate a residue", "cmd": "swapaa {{residue:/A:100}} {{new_type:ALA}}"},
    {"title": "Show the sequence of a chain", "cmd": "sequence chain /{{chain:A}}"},
    {"title": "List open models", "cmd": "info models"},
    {"title": "Superimpose two structures", "cmd": "matchmaker #{{mobile:2}} to #{{reference:1}}", "notes": "Short form: mm #2 to #1"},
    {"title": "RMSD between two models", "cmd": "rmsd #{{a:1}}@CA to #{{b:2}}@CA"},
    {"title": "Morph between conformations", "cmd": "morph #{{from:1}},{{to:2}}"},
    {"title": "Split a model into chains", "cmd": "split #{{model:1}}"},
    {"title": "Combine models into one", "cmd": "combine #{{models:1,2}}"},
    {"title": "Map contour level and style", "cmd": "volume #{{map:1}} level {{level:0.5}} style {{style:mesh}}", "notes": "Styles: surface, mesh, image"},
    {"title": "Fit a model into a map", "cmd": "fitmap #{{model:2}} inMap #{{map:1}}"},
    {"title": "Label residues", "cmd": "label {{spec:sel}} residues"},
    {"title": "Remove all labels", "cmd": "label delete"},
    {"title": "Title text on screen", "cmd": "2dlabels text \"{{text}}\" xpos 0.03 ypos 0.92 size 24"},
    {"title": "Fit everything in view", "cmd": "view"},
    {"title": "Zoom to the selection", "cmd": "view sel"},
    {"title": "Save a view", "cmd": "view name {{name:v1}}", "notes": "Go back to it with  view v1"},
    {"title": "Rotate", "cmd": "turn {{axis:y}} {{degrees:90}}"},
    {"title": "High-res transparent image", "cmd": "save {{file:figure.png}} width 3000 supersample 3 transparentBackground true"},
    {"title": "Save session", "cmd": "save {{file:session.cxs}}"},
    {"title": "Save a model as PDB", "cmd": "save {{file:model.pdb}} models #{{model:1}}", "notes": "Use .cif instead of .pdb for mmCIF"},
    {"title": "Record a spinning movie", "cmd": "movie record; turn y 2 180; wait 180; movie encode {{file:spin.mp4}}", "notes": "turn y 2 180 = 2° per frame for 180 frames, one full turn"},
    {"title": "Help for a command", "cmd": "help {{command}}", "notes": "usage {{command}} prints just the syntax"},
    {"title": "Clear the log", "cmd": "log clear"}
  ]
}
