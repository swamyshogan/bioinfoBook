{
  "tool": "tmux",
  "description": "Keep long analyses running after you disconnect — sessions, windows, panes, copy mode, config",
  "homepage": "https://github.com/tmux/tmux/wiki",
  "cheats": [
    {"title": "New named session", "cmd": "tmux new -s {{name}}"},
    {"title": "List sessions", "cmd": "tmux ls"},
    {"title": "Attach to a session", "cmd": "tmux attach -t {{name}}", "notes": "tmux a  attaches to the most recent one"},
    {"title": "Detach (leave it running)", "cmd": "prefix d", "notes": "prefix = Ctrl+b"},
    {"title": "Switch session", "cmd": "prefix s"},
    {"title": "Rename session", "cmd": "prefix $"},
    {"title": "Kill a session", "cmd": "tmux kill-session -t {{name}}"},
    {"title": "Kill every session", "cmd": "tmux kill-server"},
    {"title": "Start a job in a background session", "cmd": "tmux new -d -s {{name}} '{{command}}'"},
    {"title": "Attach and kick other clients off", "cmd": "tmux attach -d -t {{name}}"},
    {"title": "New window", "cmd": "prefix c"},
    {"title": "Rename window", "cmd": "prefix ,"},
    {"title": "Next / previous window", "cmd": "prefix n   ·   prefix p"},
    {"title": "Jump to window by number", "cmd": "prefix 0 … 9"},
    {"title": "Window and session picker", "cmd": "prefix w"},
    {"title": "Close window", "cmd": "prefix &"},
    {"title": "Move window to a number", "cmd": "prefix ."},
    {"title": "Move window one to the left", "cmd": "swap-window -t -1; select-window -t -1", "notes": "Type it after prefix :"},
    {"title": "Split left | right", "cmd": "prefix %"},
    {"title": "Split top / bottom", "cmd": "prefix \""},
    {"title": "Move between panes", "cmd": "prefix ← ↑ → ↓", "notes": "Or just click a pane (mouse is on)"},
    {"title": "Next pane", "cmd": "prefix o"},
    {"title": "Zoom pane full screen (toggle)", "cmd": "prefix z"},
    {"title": "Close pane", "cmd": "prefix x"},
    {"title": "Close all other panes", "cmd": "kill-pane -a", "notes": "Type it after prefix :"},
    {"title": "Turn pane into its own window", "cmd": "prefix !"},
    {"title": "Pull a window in as a pane", "cmd": "join-pane -s {{window:2}}", "notes": "Type it after prefix :"},
    {"title": "Cycle pane layouts", "cmd": "prefix Space"},
    {"title": "Swap panes", "cmd": "prefix {   ·   prefix }"},
    {"title": "Show pane numbers", "cmd": "prefix q"},
    {"title": "Resize pane", "cmd": "prefix Ctrl+← ↑ → ↓", "notes": "Or drag the border with the mouse, or  resize-pane -D 5  after prefix :"},
    {"title": "Type into all panes at once", "cmd": "setw synchronize-panes on", "notes": "After prefix : — turn it off with  setw synchronize-panes off"},
    {"title": "Scroll back / copy mode", "cmd": "prefix [", "notes": "q to leave. With mouse on you can just scroll."},
    {"title": "Paste the tmux buffer", "cmd": "prefix ]"},
    {"title": "Select and copy in copy mode", "cmd": "Space … Enter   (vi keys)   ·   Ctrl+Space … Alt+w   (emacs keys)", "notes": "tmux uses vi keys if $EDITOR or $VISUAL mentions vi, otherwise emacs keys"},
    {"title": "Search in copy mode", "cmd": "/ then n for next   (vi)   ·   Ctrl+s   (emacs)"},
    {"title": "Copy with the mouse", "cmd": "drag to select — releasing copies it", "notes": "Hold Option in iTerm2 (Shift in many other terminals) to select the normal terminal way"},
    {"title": "List / choose paste buffers", "cmd": "prefix ="},
    {"title": "Save a pane's scrollback to a file", "cmd": "tmux capture-pane -pS -{{lines:3000}} > {{file:pane.txt}}"},
    {"title": "Command prompt", "cmd": "prefix :"},
    {"title": "List every key binding", "cmd": "prefix ?"},
    {"title": "Big clock", "cmd": "prefix t"},
    {"title": "Send a command to another session", "cmd": "tmux send-keys -t {{target}} '{{command}}' Enter"},
    {"title": "Reload config", "cmd": "tmux source ~/.tmux.conf"},
    {"title": "Mouse support", "cmd": "set -g mouse on"},
    {"title": "Number windows and panes from 1", "cmd": "set -g base-index 1\nsetw -g pane-base-index 1"},
    {"title": "Stop windows renaming themselves", "cmd": "set -g allow-rename off"},
    {"title": "Full 24-bit colour", "cmd": "set -ag terminal-overrides \",*:RGB\""},
    {"title": "Open bioinfoBook as a popup on prefix C", "cmd": "bind C display-popup -E -w 85% -h 80% -b rounded \"bioinfobook --pane '#{pane_id}'\""}
  ]
}
